{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monobit",
  "version": "1.0.0",
  "identifier": "com.monobit.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Monobit",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false,
        "center": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "1-bit pixel art studio",
    "longDescription": "Monobit is a black-and-white pixel art editor with dither patterns, vector shapes, pixel text, drop shadows and reusable components.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["monobit"],
        "name": "Monobit Document",
        "description": "Monobit 1-bit pixel art document",
        "role": "Editor"
      }
    ]
  }
}
